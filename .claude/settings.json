{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "command": "code-review-graph update --skip-flows",
        "timeout": 5000
      }
    ],
    "SessionStart": [
      {
        "command": "code-review-graph status",
        "timeout": 3000
      }
    ],
    "PreCommit": [
      {
        "command": "code-review-graph detect-changes --brief",
        "timeout": 10000
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "mcp__code-review-graph__detect_changes_tool",
      "Bash(xargs grep *)",
      "Bash(npm install *)",
      "Bash(npm list *)"
    ]
  }
}
