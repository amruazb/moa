# Supabase Configuration
# Get these values from your Supabase project settings: https://app.supabase.com/project/_/settings/api

# Project URL - Get this from Settings → API → Project URL
# Format: https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable Key (for client-side operations - safe to expose)
# New format: sb_publishable_... (recommended)
# Legacy format: eyJhbGci... (JWT token, still supported)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here

# Secret Key (for server-side operations only - keep this secret!)
# New format: sb_secret_... (recommended)
# Legacy format: eyJhbGci... (JWT token, still supported)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here
